region       = "eu-central-1"
project_name = "alnao-dev-terraform-esempio20"

# Immagine copiata da Docker Hub su ECR.
# Per passare a una nuova versione basta cambiare image_tag (o usare -var image_tag=...)
# e rifare apply: la nuova immagine viene copiata e l'istanza ricreata.
# Versioni disponibili: https://hub.docker.com/r/pathsgames/pathsgames/tags
source_image   = "pathsgames/pathsgames"
image_tag      = "1.12.0"
image_platform = "linux/amd64"

# Repository ECR (vuoto = <project_name>-pathsgames, nome atteso dall'esempio 21)
# repository_name = "alnao-dev-terraform-esempio20-pathsgames"

# Istanza: la JVM e postgres insieme hanno bisogno di almeno 2 GB
instance_type = "t3.small"
host_port     = 80

# Chi puo' chiamare l'applicazione (meglio il proprio IP: "x.x.x.x/32")
http_cidr_blocks = ["0.0.0.0/0"]

# Rete: se lasciati vuoti si usano VPC di default e la sua prima subnet
# vpc_id    = "vpc-xxxxxxxx"
# subnet_id = "subnet-xxxxxxxx"

# Tags
# tags = {
#   Name        = "aws-esempio20.ecr"
#   Environment = "dev"
#   Project     = "Development.aws.terraform20-ECR"
#   Owner       = "AlNao"
#   CostCenter  = "dev"
#   ManagedBy   = "Terraform"
